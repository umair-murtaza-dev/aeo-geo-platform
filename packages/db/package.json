{
  "name": "@aeo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "tsx src/run-prisma.ts generate",
    "validate": "tsx src/run-prisma.ts validate",
    "migrate:status": "tsx src/run-prisma.ts migrate status",
    "migrate:deploy": "tsx src/run-prisma.ts migrate deploy",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "check": "tsx src/check-connection.ts",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@aeo/shared": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv": "18.0.8",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
