// Canonical schema for the AEO/GEO platform.
// Connections: DATABASE_URL is the pooled Neon URL used at runtime.
// DIRECT_URL is the direct Neon URL used by Prisma migrations.
// Do not store provider secrets or password plaintext in these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  CLIENT_VIEWER
}

enum OrganizationKind {
  AGENCY
  BUSINESS
}

enum PromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ScheduleCadence {
  MANUAL
  HOURLY
  DAILY
  WEEKLY
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ObservationSurface {
  MODEL_API
  GROUNDED_SEARCH
  CONSUMER_SEARCH
}

enum ExecutionStatus {
  SUCCEEDED
  FAILED
  PARTIAL
}

enum AuditJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
  IMPLEMENTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

enum CohortRole {
  BASELINE
  CONTROL
  TREATMENT
}

enum ReportStatus {
  DRAFT
  READY
  FAILED
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

enum ExportFormat {
  PDF
  CSV
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  month
  year
}

/// Auth.js user. Account and Session primary keys stay text because Auth.js may supply its own ids.
/// User ids are generated by the database as UUIDs. The adapter strips inbound user ids.
model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String?
  email         String?      @unique
  emailVerified DateTime?    @db.Timestamptz(6)
  image         String?
  passwordHash  String?      @map("password_hash")
  platformRole  PlatformRole @default(NONE) @map("platform_role")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMembership[]
  workspaceMemberships    WorkspaceMembership[]
  promptVersions          PromptVersion[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  kind      OrganizationKind
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       OrganizationMembership[]
  workspaces        ClientWorkspace[]
  secretRefs        ProviderSecretRef[]
  usageRecords      UsageRecord[]
  subscription      Subscription?
  billingEvents     BillingEvent[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model ClientWorkspace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  WorkspaceMembership[]
  brands       Brand[]
  reports      Report[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("client_workspaces")
}

model WorkspaceMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace ClientWorkspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("workspace_memberships")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         ClientWorkspace              @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  domains           BrandDomain[]
  locations         BrandLocation[]
  competitors       Competitor[]
  prompts           MonitoringPrompt[]
  schedules         MonitoringSchedule[]
  runs              MonitoringRun[]
  observations      AIObservation[]
  auditJobs         AuditJob[]
  recommendations   OptimizationRecommendation[]
  experiments       Experiment[]
  reports           Report[]
  mentions          BrandMention[]

  @@unique([organizationId, id])
  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("brands")
}

model BrandDomain {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  hostname       String
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand Brand @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)

  @@unique([brandId, hostname])
  @@index([organizationId])
  @@map("brand_domains")
}

model BrandLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  name           String
  countryCode    String   @map("country_code") @db.Char(2)
  region         String?
  city           String?
  locale         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand     Brand                @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  schedules MonitoringSchedule[]

  @@unique([organizationId, id])
  @@unique([brandId, name])
  @@index([organizationId])
  @@map("brand_locations")
}

model Competitor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  name           String
  domain         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand    Brand          @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  mentions BrandMention[]

  @@unique([brandId, name])
  @@index([organizationId])
  @@map("competitors")
}

model MonitoringPrompt {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  brandId          String       @map("brand_id") @db.Uuid
  title            String
  slug             String
  status           PromptStatus @default(DRAFT)
  /// Pointer to the current PromptVersion. Not a foreign key, so versions stay immutable if the pointer moves.
  currentVersionId String?      @map("current_version_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand     Brand                @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  versions  PromptVersion[]
  schedules MonitoringSchedule[]

  @@unique([organizationId, id])
  @@unique([brandId, slug])
  @@index([organizationId])
  @@map("monitoring_prompts")
}

/// Immutable prompt text. Corrections create a new version.
model PromptVersion {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  promptId        String   @map("prompt_id") @db.Uuid
  version         Int
  body            String   @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prompt       MonitoringPrompt @relation(fields: [organizationId, promptId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs         MonitoringRun[]
  observations AIObservation[]

  @@unique([promptId, version])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("prompt_versions")
}

model MonitoringSchedule {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  promptId       String          @map("prompt_id") @db.Uuid
  brandId        String          @map("brand_id") @db.Uuid
  locationId     String?         @map("location_id") @db.Uuid
  providerId     String?         @map("provider_id")
  cadence        ScheduleCadence
  timezone       String          @default("UTC")
  locale         String?
  surface        ObservationSurface?
  engineId       String?         @map("engine_id")
  enabled        Boolean         @default(true)
  nextRunAt      DateTime?       @map("next_run_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  prompt   MonitoringPrompt @relation(fields: [organizationId, promptId], references: [organizationId, id], onDelete: Restrict)
  brand    Brand            @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location BrandLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  provider AIProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  runs     MonitoringRun[]

  @@index([organizationId, enabled, nextRunAt])
  @@map("monitoring_schedules")
}

model MonitoringRun {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  scheduleId       String?   @map("schedule_id") @db.Uuid
  promptVersionId  String    @map("prompt_version_id") @db.Uuid
  brandId          String    @map("brand_id") @db.Uuid
  status           RunStatus @default(QUEUED)
  idempotencyKey   String    @unique @map("idempotency_key")
  providerId       String?   @map("provider_id")
  surface          ObservationSurface?
  engineId         String?   @map("engine_id")
  locale           String?
  scheduledFor     DateTime? @map("scheduled_for") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  errorCode        String?   @map("error_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule      MonitoringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  promptVersion PromptVersion       @relation(fields: [organizationId, promptVersionId], references: [organizationId, id], onDelete: Restrict)
  brand         Brand               @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  provider      AIProvider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  observations  AIObservation[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@map("monitoring_runs")
}

/// Public provider catalog. Secrets live outside the database; see ProviderSecretRef.
model AIProvider {
  id          String   @id
  displayName String   @map("display_name")
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  secretRefs    ProviderSecretRef[]
  schedules     MonitoringSchedule[]
  runs          MonitoringRun[]
  observations  AIObservation[]

  @@map("ai_providers")
}

/// Name of a secret in the external secret store. Never the secret value.
model ProviderSecretRef {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  providerId     String   @map("provider_id")
  secretName     String   @map("secret_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider     AIProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, providerId])
  @@map("provider_secret_refs")
}

/// Immutable monitoring evidence. Application code must insert rows and must not update them.
model AIObservation {
  id                    String             @id @default(uuid()) @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  runId                 String             @map("run_id") @db.Uuid
  brandId               String             @map("brand_id") @db.Uuid
  providerId            String             @map("provider_id")
  surface               ObservationSurface
  engineId              String             @map("engine_id")
  locale                String?
  market                String?
  executedAt            DateTime           @map("executed_at") @db.Timestamptz(6)
  status                ExecutionStatus
  promptVersionId       String             @map("prompt_version_id") @db.Uuid
  rawResponseRef        String?            @map("raw_response_ref")
  rawResponseSha256     String?            @map("raw_response_sha256") @db.Char(64)
  inputTokens           Int?               @map("input_tokens")
  outputTokens          Int?               @map("output_tokens")
  totalTokens           Int?               @map("total_tokens")
  estimatedCostAmount   Decimal?           @map("estimated_cost_amount") @db.Decimal(18, 6)
  estimatedCostCurrency String?            @map("estimated_cost_currency") @db.Char(3)
  actualCostAmount      Decimal?           @map("actual_cost_amount") @db.Decimal(18, 6)
  actualCostCurrency    String?            @map("actual_cost_currency") @db.Char(3)
  latencyMs             Int?               @map("latency_ms")
  errorCategory         String?            @map("error_category")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  run                  MonitoringRun          @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  brand                Brand                  @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  provider             AIProvider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  promptVersion        PromptVersion          @relation(fields: [organizationId, promptVersionId], references: [organizationId, id], onDelete: Restrict)
  citations            ObservationCitation[]
  mentions             BrandMention[]
  experimentLinks      ExperimentObservation[]

  @@unique([organizationId, id])
  @@index([organizationId, executedAt])
  @@index([brandId, executedAt])
  @@index([runId])
  @@map("ai_observations")
}

model ObservationCitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  observationId  String   @map("observation_id") @db.Uuid
  url            String
  title          String?
  domain         String?
  position       Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  observation AIObservation @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([observationId])
  @@map("observation_citations")
}

model BrandMention {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  observationId  String   @map("observation_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  competitorId   String?  @map("competitor_id") @db.Uuid
  mentioned      Boolean
  excerpt        String?
  position       Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  observation AIObservation @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Restrict)
  brand       Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  competitor  Competitor?   @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([observationId])
  @@index([brandId])
  @@map("brand_mentions")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metric         String
  quantity       Decimal  @db.Decimal(18, 6)
  unit           String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  sourceType     String?  @map("source_type")
  sourceId       String?  @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, metric, occurredAt])
  @@map("usage_records")
}

model AuditJob {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  brandId        String         @map("brand_id") @db.Uuid
  domainId       String?        @map("domain_id") @db.Uuid
  status         AuditJobStatus @default(QUEUED)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand    Brand          @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  findings AuditFinding[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("audit_jobs")
}

model AuditFinding {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  auditJobId     String          @map("audit_job_id") @db.Uuid
  code           String
  severity       FindingSeverity
  title          String
  detail         String?         @db.Text
  evidenceRef    String?         @map("evidence_ref")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  auditJob        AuditJob                     @relation(fields: [organizationId, auditJobId], references: [organizationId, id], onDelete: Restrict)
  recommendations OptimizationRecommendation[]

  @@unique([organizationId, id])
  @@index([auditJobId])
  @@map("audit_findings")
}

model OptimizationRecommendation {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  brandId        String               @map("brand_id") @db.Uuid
  findingId      String?              @map("finding_id") @db.Uuid
  title          String
  body           String               @db.Text
  status         RecommendationStatus @default(OPEN)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand   Brand           @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  finding AuditFinding?   @relation(fields: [findingId], references: [id], onDelete: SetNull)
  tasks   ImplementationTask[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("optimization_recommendations")
}

model ImplementationTask {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  recommendationId String     @map("recommendation_id") @db.Uuid
  title            String
  status           TaskStatus @default(TODO)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  recommendation OptimizationRecommendation @relation(fields: [organizationId, recommendationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@map("implementation_tasks")
}

model Experiment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  brandId        String           @map("brand_id") @db.Uuid
  name           String
  hypothesis     String?          @db.Text
  status         ExperimentStatus @default(DRAFT)
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand         Brand                    @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  interventions ExperimentIntervention[]
  cohorts       ExperimentCohort[]
  results       ExperimentResult[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("experiments")
}

model ExperimentIntervention {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  experimentId   String    @map("experiment_id") @db.Uuid
  title          String
  description    String?   @db.Text
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  experiment Experiment @relation(fields: [organizationId, experimentId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@map("experiment_interventions")
}

model ExperimentCohort {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  experimentId   String     @map("experiment_id") @db.Uuid
  role           CohortRole
  name           String
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  experiment   Experiment             @relation(fields: [organizationId, experimentId], references: [organizationId, id], onDelete: Restrict)
  observations ExperimentObservation[]

  @@unique([organizationId, id])
  @@index([experimentId])
  @@map("experiment_cohorts")
}

/// Links a cohort to an immutable observation. Deleting the observation is restricted.
model ExperimentObservation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  cohortId       String   @map("cohort_id") @db.Uuid
  observationId  String   @map("observation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cohort      ExperimentCohort @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Restrict)
  observation AIObservation    @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([cohortId, observationId])
  @@index([organizationId])
  @@map("experiment_observations")
}

/// Append-only computed results. Recomputation inserts a new row.
model ExperimentResult {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  experimentId     String   @map("experiment_id") @db.Uuid
  metric           String
  estimate         Decimal  @db.Decimal(18, 6)
  lowerBound       Decimal? @map("lower_bound") @db.Decimal(18, 6)
  upperBound       Decimal? @map("upper_bound") @db.Decimal(18, 6)
  confidenceLevel  Decimal? @map("confidence_level") @db.Decimal(5, 4)
  computedAt       DateTime @map("computed_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  experiment Experiment @relation(fields: [organizationId, experimentId], references: [organizationId, id], onDelete: Restrict)

  @@index([experimentId, computedAt])
  @@map("experiment_results")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  brandId        String?      @map("brand_id") @db.Uuid
  title          String
  status         ReportStatus @default(DRAFT)
  periodStart    DateTime?    @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime?    @map("period_end") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace ClientWorkspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  brand     Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  exports   ReportExport[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("reports")
}

model ReportExport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  reportId       String       @map("report_id") @db.Uuid
  format         ExportFormat
  storageRef     String?      @map("storage_ref")
  status         ExportStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [organizationId, reportId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@map("report_exports")
}

model Plan {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String?
  currency    String          @db.Char(3)
  amountMinor Int             @map("amount_minor")
  interval    BillingInterval
  active      Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlements  Entitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

model Entitlement {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String
  limitInt  Int?     @map("limit_int")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, key])
  @@map("entitlements")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus
  currency               String             @db.Char(3)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  stripeCustomerRef      String?            @map("stripe_customer_ref")
  stripeSubscriptionRef  String?            @map("stripe_subscription_ref")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("subscriptions")
}

model BillingEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  amountMinor    Int?     @map("amount_minor")
  currency       String?  @db.Char(3)
  externalRef    String?  @map("external_ref")
  /// Non-sensitive processor metadata only. Do not store card numbers or raw webhook secrets.
  payload        Json?
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@map("billing_events")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
