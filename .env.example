# Copy to .env at the repository root. Do not commit .env.
# Values below are placeholders. Never put real credentials in this file.

# Neon pooled connection used by the running application (Prisma runtime).
# Omit channel_binding. Prisma 6.19.3 reports that parameter as an unreachable server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require

# Neon direct connection used by Prisma migrations. Do not use the pooled host here.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=require

# Dedicated disposable database for tests. Never point this at a shared development database.
# TEST_DATABASE_URL=postgresql://aeo:aeo@127.0.0.1:54329/aeo_test

# Auth.js and Express share this secret to verify short-lived API access tokens.
# Generate with: openssl rand -base64 32
# Minimum 32 characters. Required to sign in or call authenticated API routes.
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters

# Comma-separated browser origins allowed to call the Express API.
CORS_ORIGINS=http://localhost:3000

# Express listen port.
PORT=4000

# Next.js public site URL. Used as the Auth.js canonical host in local development.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Redis for BullMQ. Local default from infrastructure/docker/docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379

LOG_LEVEL=info
NODE_ENV=development

# Set to 1 only when the API is behind a trusted reverse proxy such as an AWS ALB.
TRUST_PROXY=0
